# Copy to .env next to phone_client.py, fill in, then: chmod 600 .env
# Relay WebSocket URL (wss:// only; ws:// is accepted for localhost testing).
RELAY_URL=wss://phone-relay-CHANGEME.CHANGEME.workers.dev/device
# Must match the Worker's DEVICE_TOKEN secret.
DEVICE_TOKEN=
# Optional: adb serial, e.g. localhost:37123. Needed if `adb devices` lists more than one entry.
ADB_SERIAL=
# Optional: path to adb (default: adb on PATH).
ADB_BIN=
